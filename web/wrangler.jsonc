{
  // HarmonyVoice: static page + API + one Durable Object per conversation room
  "name": "harmonyvoice",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
  // Secret (set in the Cloudflare dashboard, never in this file): GEMINI_API_KEY
}
