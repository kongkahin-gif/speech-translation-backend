{
  // HarmonyVoice: static site + API + Durable Objects (rooms, lobby, accounts)
  "name": "harmonyvoice",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "USER", "class_name": "User" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby", "User"] }
  ]
  // Secrets (set in the Cloudflare dashboard, never in this file):
  //   GEMINI_API_KEY    - required, for translation and the argument tree
  //   GOOGLE_CLIENT_ID  - optional, turns on "Sign in with Google"
}
